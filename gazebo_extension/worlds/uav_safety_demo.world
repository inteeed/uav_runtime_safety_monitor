<?xml version="1.0"?>
<sdf version="1.6">
  <world name="uav_safety_demo">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>20.0</update_rate>
    </plugin>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://safety_uav</uri>
      <name>safety_uav</name>
      <pose>0 0 0.5 0 0 0</pose>
    </include>

    <model name="geofence_marker">
      <static>true</static>
      <link name="link">
        <visual name="north">
          <pose>0 50 0.02 0 0 0</pose>
          <geometry>
            <box><size>100 0.2 0.04</size></box>
          </geometry>
          <material><ambient>0 0.8 0.2 1</ambient><diffuse>0 0.8 0.2 1</diffuse></material>
        </visual>
        <visual name="south">
          <pose>0 -50 0.02 0 0 0</pose>
          <geometry>
            <box><size>100 0.2 0.04</size></box>
          </geometry>
          <material><ambient>0 0.8 0.2 1</ambient><diffuse>0 0.8 0.2 1</diffuse></material>
        </visual>
        <visual name="east">
          <pose>50 0 0.02 0 0 0</pose>
          <geometry>
            <box><size>0.2 100 0.04</size></box>
          </geometry>
          <material><ambient>0 0.8 0.2 1</ambient><diffuse>0 0.8 0.2 1</diffuse></material>
        </visual>
        <visual name="west">
          <pose>-50 0 0.02 0 0 0</pose>
          <geometry>
            <box><size>0.2 100 0.04</size></box>
          </geometry>
          <material><ambient>0 0.8 0.2 1</ambient><diffuse>0 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
